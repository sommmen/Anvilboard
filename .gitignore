# .NET
bin/
obj/
*.user
*.suo
.vs/

# SQLite runtime data (local-first: these are per-machine, not source)
*.db
*.db-shm
*.db-wal

# Angular build output copied into the API host's static-file root.
# Regenerated by `npm run build` (see DEVELOPMENT.md) — not checked in, since
# the Api host expects it to be built fresh, and committing generated JS
# bundles would just create merge noise.
src/Anvilboard.Api/wwwroot/*
!src/Anvilboard.Api/wwwroot/.gitkeep

# Node (anvilboard-web has its own, more detailed, .gitignore; these are a
# backstop in case node artifacts ever land outside that folder)
node_modules/
npm-debug.log*

# IDEs / editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# OS
.DS_Store
Thumbs.db
