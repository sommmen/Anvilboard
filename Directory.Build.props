<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- Output goes to .a/{bin,obj,publish}/<project>/<configuration>, see: https://learn.microsoft.com/en-us/dotnet/core/sdk/artifacts-output -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory).a</ArtifactsPath>
  </PropertyGroup>
</Project>
