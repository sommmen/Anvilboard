<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Anvilboard.Domain\Anvilboard.Domain.csproj" />
    <ProjectReference Include="..\Anvilboard.Plugins.Abstractions\Anvilboard.Plugins.Abstractions.csproj" />
    <ProjectReference Include="..\Anvilboard.Infrastructure\Anvilboard.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The sync coordinator's backoff policy (how long a failing provider waits, and when a bad
      credential is quarantined instead of retried) is a correctness concern worth testing directly,
      but it is not something callers should be able to invoke. Exposing it to the test assembly
      keeps it verifiable without widening the public API.
    -->
    <InternalsVisibleTo Include="Anvilboard.Application.Tests" />
  </ItemGroup>

</Project>
